{
  "expo": {
    "name": "LineageX",
    "slug": "lineagex",
    "scheme": "lineagex",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/file.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LineageX to add photos to family memories.",
          "cameraPermission": "Allow LineageX to take photos for family memories.",
          "microphonePermission": false
        }
      ]
    ],
    "orientation": "portrait",
      "icon": {
        "light": "./assets/ios-light.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kingwillyo.lineagex"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pkg.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kingwillyo.lineagex"
    }
  }
}

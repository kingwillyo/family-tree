{
  "expo": {
    "name": "LineageX",
    "slug": "lineagex",
    "scheme": "lineagex",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/file.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LineageX to add photos to family memories.",
          "cameraPermission": "Allow LineageX to take photos for family memories.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon-dark.png"
        }
      ],
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kingwillyo.lineagex"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pkg.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kingwillyo.lineagex"
    }
  }
}
